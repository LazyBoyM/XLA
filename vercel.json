{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 scripts/check_assets.py",
  "outputDirectory": "public",
  "functions": {
    "api/process.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,.git/**,.qa/**,outputs/**,tests/**,__pycache__/**,app.py,web_local.py,*.cmd}"
    }
  },
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "same-origin"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"}
    ]}
  ]
}
